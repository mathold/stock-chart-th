flowchart TD
    A["ราคาขยับ 1 tick"] --> B["ดูแลไม้ที่เปิดอยู่<br/>Break-even / Trailing"]
    B --> C{"ศุกร์ใกล้ปิดตลาด ?"}
    C -- ใช่ --> C1["ปิดไม้ทั้งหมด"] --> Z(["จบรอบ"])
    C -- ไม่ --> D{"แท่งใหม่หรือยัง ?"}
    D -- "ยังแท่งเดิม" --> Z

    D -- "แท่งใหม่" --> E{"EMA25 ตัด EMA75 ไหม<br/>ที่แท่งปิดแล้ว ?"}
    E -- "ตัดขึ้น = BUY" --> F
    E -- "ตัดลง = SELL" --> F
    E -- "ไม่ตัด" --> Z

    F{"ตอนนี้ถือไม้อะไรอยู่ ?"}
    F -- "ถือไม้สวนทาง" --> F1["ปิดไม้เดิมทันที"] --> G
    F -- "ถือไม้ทางเดียวกัน" --> Z
    F -- "ไม่มีไม้" --> G

    G{"ผ่านตัวกรองที่เปิดใช้ครบไหม ?<br/>1 เทรนด์ใหญ่ EMA200<br/>2 ความแรง ADX<br/>3 ริบบิ้นกว้างพอ ATR<br/>4 ยืนยัน 2 แท่งติด"}
    G -- ไม่ผ่าน --> X(["ไม่เข้าไม้"])
    G -- ผ่าน --> H{"สเปรดไม่กว้าง<br/>และอยู่ในชั่วโมงเทรด ?"}
    H -- ไม่ผ่าน --> X
    H -- ผ่าน --> I["คำนวณ SL 2xATR · TP 4xATR<br/>ล็อตจากความเสี่ยง 1% ของพอร์ต"]

    I --> J{"มาร์จิ้นพอไหม ?"}
    J -- ไม่พอ --> X
    J -- พอ --> K["ส่งคำสั่ง BUY หรือ SELL<br/>พร้อม SL / TP"]
    K --> L["ถือไม้เดียว"]

    L --> M{"ออกจากไม้เมื่อไหร่"}
    M --> M1["โดน SL"]
    M --> M2["ถึง TP"]
    M --> M3["EMA ตัดกลับอีกทาง"]
    M --> M4["SL ถูกเลื่อน<br/>Break-even / Trailing"]

    classDef stop fill:#eeeeee,stroke:#999,color:#000
    classDef act fill:#fff6d6,stroke:#e8a800,color:#000
    classDef exit fill:#ffe0ef,stroke:#e23b3b,color:#000
    classDef win fill:#d8f5e3,stroke:#00a651,color:#000
    class X,Z stop
    class C1,F1,K,L act
    class M1,M3 exit
    class M2 win
    class M4 act
